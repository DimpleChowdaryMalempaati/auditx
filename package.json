{
  "name": "auditx",
  "version": "0.1.0",
  "description": "Enterprise-grade, modular audit logging framework for Node.js applications.",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspace=apps/example-express",
    "lint": "npm run lint --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rimraf packages/**/dist apps/**/dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:ps": "docker compose -f docker/docker-compose.yml ps"
  },
  "keywords": [
    "audit",
    "audit-log",
    "logging",
    "node",
    "express",
    "typescript",
    "postgres",
    "middleware",
    "auditx"
  ],
  "author": "Dimple Malempaati",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DimpleChowdaryMalempaati/auditx.git"
  },
  "bugs": {
    "url": "https://github.com/DimpleChowdaryMalempaati/auditx/issues"
  },
  "homepage": "https://github.com/DimpleChowdaryMalempaati/auditx#readme",
  "engines": {
    "node": ">=22",
    "npm": ">=10.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "changesets": "^1.0.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.3",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tsdown": "^0.21.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
